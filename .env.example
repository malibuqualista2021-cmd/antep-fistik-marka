# --- Admin panel (zorunlu) ---
ADMIN_DASHBOARD_PASSWORD=buraya-guclu-bir-sifre-yazin

# ADMIN_DASHBOARD_SECRET=rastgele-uzun-dizi

# Netlify / üretim: Tanımlıysa /dashboard tamamen kapanır; panele sadece şu adresle girilir:
# https://DOMAIN/yonetim/AŞAĞIDAKİ-AYNI-DEĞER
# ADMIN_PANEL_SLUG=rastgele-uzun-tahmin-edilemez-dizi

# Netlify üretimde katalog/site ayarı için Blobs — ortamda otomatik algılanır; sorun olursa Netlify’da açın:
# RUNTIME_JSON_USE_BLOBS=1

# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_FOLDER=antep-fistik-marka
